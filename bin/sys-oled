#!/usr/bin/env python3

# /// script
# requires-python = ">=3.9"
# dependencies = [
#   "luma.oled",
#   "luma.emulator",
#   "psutil",
# ]
# ///

import argparse
import signal
import os
import sys
import time
import psutil
import configparser
from datetime import datetime
from luma.core import cmdline, error
from luma.core.render import canvas
from PIL import Image, ImageDraw, ImageFont

from socket import AF_INET


# CalVer: YYYY.MM.MICRO
__version__ = '2026.04.1'


# Load presets
contrast = 255
refresh = 10
show_logo = True
net_name =  'eth0'
s1_name = 'sd'
s1_path = '/'

s2_name = None
s2_path = None

dim_begin_hour = -1
dim_until_hour = -1

# Load config file
config_file = os.environ.get('SYS_OLED_CONFIG', '/etc/sys-oled.conf')
if os.path.isfile(config_file):
    config = configparser.ConfigParser()
    config.read(config_file)
    contrast = int(config.get('main', 'contrast'))
    refresh = float(config.get('main', 'refresh'))
    show_logo = config.getboolean('main', 'show_logo')
    net_name = config.get('device', 'network_name')
    s1_name = config.get('device', 'storage1_name')
    s1_path = config.get('device', 'storage1_path')
    s2_name = config.get('device', 'storage2_name', fallback=None)
    s2_path = config.get('device', 'storage2_path', fallback=None)

    # Night Mode extension
    dim_contrast = config.getint('night_mode', 'contrast', fallback=0)
    dim_begin_hour = config.getint('night_mode', 'dim_begin_hour', fallback=-1)
    dim_until_hour = config.getint('night_mode', 'dim_until_hour', fallback=-1)


# Load font
font_path = os.path.abspath(os.path.join(os.path.dirname(__file__),
                                '../share/sys-oled', 'C&C Red Alert [INET].ttf'))
font = ImageFont.truetype(font_path, 12)


def get_device(actual_args=None):
    if actual_args is None:
        actual_args = sys.argv[1:]

    base_parser = argparse.ArgumentParser(
        description='luma.core arguments',
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    base_parser.add_argument(
        "--version",
        action='version',
        version="%(prog)s version " + __version__,
    )

    parser = cmdline.create_parser(
        # description is only used to initialize a default parser if one is not passed.
        description=None,
        parser=base_parser,
    )
    args = parser.parse_args(actual_args)

    if args.config:
        config = cmdline.load_config(args.config)
        args = parser.parse_args(config + actual_args)

    try:
        device = cmdline.create_device(args)
    except error.Error as e:
        device = None
        parser.error(str(e))

    assert device is not None, (
        "luma.core.cmdline.create_device returned None for args: %r" % args
    )
    return device

def bytes2human(n):
    symbols = ('K', 'M', 'G', 'T', 'P', 'E', 'Z', 'Y')
    prefix = {}
    for i, s in enumerate(symbols):
        prefix[s] = 1 << (i + 1) * 10
    for s in reversed(symbols):
        if n >= prefix[s]:
            value = float(n) / prefix[s]
            if s in ['K', 'M']:
                return '%d%s' % (int(value), s)
            else:
                return '%.1f%s' % (value, s)
    return "%sB" % n

def cpu_usage():
    load = psutil.cpu_percent(interval=None)
    temps = psutil.sensors_temperatures()
    try:
        temp = temps['f10e4078.thermal'][0].current
    except (KeyError, IndexError):
        temp = "--"
    uptime = datetime.now().replace(second=0, microsecond=0) - datetime.fromtimestamp(psutil.boot_time())
    return "ld: %s%% T: %sC up: %s" \
        % (str(load).split('.')[0], str(temp).split('.')[0], str(uptime).split(',')[0][:-3])

def mem_usage():
    usage = psutil.virtual_memory()
    return "mem: %s / %s - %.0f%%" \
        % (bytes2human(usage.used), bytes2human(usage.total), usage.percent)

def disk_usage(name, dir):
    usage = psutil.disk_usage(dir)
    return name + ": %s / %s - %.0f%%" \
        % (bytes2human(usage.used), bytes2human(usage.total), usage.percent)

def network(iface):
    ipv4_ifaces = {
        name: nicaddr
        for name, addrs in psutil.net_if_addrs().items()
        for nicaddr in addrs
        if nicaddr.family == AF_INET
    }

    try:
        nic = ipv4_ifaces[iface]
    except KeyError:
        return "%s: no ipv4 connection" % (iface)

    return "%s: %s" \
        % (iface, nic.address)

def host_time():
    now = datetime.now()
    hostname = os.uname()[1]
    return hostname + " " + now.strftime("%Y-%m-%d %H:%M")

class CanvasCursor:
    def __init__(self, draw, x=0, y=0, width=128, line_height=11, line_spacing=1):
        self.x = x
        self.y = y

        # font-specific
        self.line_height = line_height
        self.line_spacing = line_spacing
        self.width = width

        self.draw = draw

    @property
    def coords(self):
        return (self.x, self.y)

    def text(self, *args, **kwargs):
        """Calls ImageDraw.text() with a pre-calculated xy argument"""
        x, y = self.coords

        self.draw.text((x, y), *args, **kwargs)

        # add a carriage return (x=0) and line feed (y+=line_height)
        self.x = 0
        self.y = y + self.line_height + self.line_spacing

    def line(self, *args, **kwargs):
        """Calls ImageDraw.line() with a pre-calculated xy argument"""
        x, y = self.coords

        y += self.line_spacing
        self.draw.line((x, y) + (self.width, y), *args, **kwargs)
        y += self.line_spacing

        # add a carriage return (x=0) and line feed (y+=line_height)
        self.x = 0
        self.y = y + self.line_spacing

def display_info(device):
    with canvas(device) as draw:
        cursor = CanvasCursor(draw)

        cursor.text(cpu_usage(), font=font, fill="white")
        cursor.line(fill="white")
        cursor.text(mem_usage(), font=font, fill="white")
        cursor.text(disk_usage(s1_name, s1_path), font=font, fill="white")
        if s2_name is not None and s2_path is not None:
            # always assume storage2 is a RAID mountpoint
            cursor.text(
                disk_usage(s2_name, s2_path)
                if os.path.ismount(s2_path)
                else s2_name + ": not mounted",
                font=font,
                fill="white",
            )
        cursor.text(network(net_name), font=font, fill="white")

def logo(device, msg):
    img_path = os.path.abspath(os.path.join(os.path.dirname(__file__),
        '../share/sys-oled', 'helios4_logo.png'))
    logo = Image.open(img_path).convert("RGBA")

    with canvas(device) as draw:
        draw.bitmap((0, 0), logo, fill="white")
        draw.text((0,52), msg, font=font, fill="white")

def sigterm_handler(_signum, _frame):
    sys.exit(0)

signal.signal(signal.SIGTERM, sigterm_handler)


def main():
    maybe_show_logo = show_logo

    while True:
        now = datetime.now().astimezone()
        if (
            (dim_begin_hour > -1 and now.hour >= dim_begin_hour)
            or (dim_until_hour > -1 and now.hour <= dim_until_hour)
        ):
            device.contrast(dim_contrast)
            maybe_show_logo = True
        else:
            device.contrast(contrast)
            maybe_show_logo = show_logo

        display_info(device)
        time.sleep(refresh)
        if maybe_show_logo:
            logo(device, host_time())
            time.sleep(refresh / 2)

if __name__ == "__main__":
    os.environ["PYGAME_HIDE_SUPPORT_PROMPT"] = "1"

    try:
        device = get_device()
        device.contrast(contrast)
        main()
    except KeyboardInterrupt:
        pass
